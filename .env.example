# Production environment variables template
# Copy this to .env and fill in your actual values

# ============================================
# AI PROVIDER CONFIGURATION
# ============================================
# Azure OpenAI
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_MODEL=gpt-4-turbo-preview
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview

# DeepSeek R1
DEEPSEEK_R1_API_KEY=your_deepseek_api_key_here
DEEPSEEK_R1_ENDPOINT=https://your-resource.openai.azure.com/

# GPT-4o
GPT4O_API_KEY=your_gpt4o_api_key_here
GPT4O_ENDPOINT=https://your-resource.openai.azure.com/openai/deployments/gpt-4o

# ============================================
# SOCIAL MEDIA API CREDENTIALS
# ============================================
# Twitter/X
TWITTER_CLIENT_ID=your_twitter_client_id
TWITTER_CLIENT_SECRET=your_twitter_client_secret
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# Facebook
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_CLIENT_ID=your_facebook_client_id
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret
FACEBOOK_ACCESS_TOKEN=your_facebook_access_token
FACEBOOK_PAGE_ID=your_facebook_page_id

# LinkedIn
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token
LINKEDIN_COMPANY_ID=your_linkedin_company_id

# Instagram
INSTAGRAM_CLIENT_ID=your_instagram_client_id
INSTAGRAM_CLIENT_SECRET=your_instagram_client_secret
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password

# ============================================
# BLOG PLATFORM CREDENTIALS
# ============================================
# WordPress
WORDPRESS_URL=https://yourstartup.com
WORDPRESS_USERNAME=your_wordpress_username
WORDPRESS_PASSWORD=your_wordpress_password

# Medium
MEDIUM_ACCESS_TOKEN=your_medium_access_token

# Ghost
GHOST_API_KEY=your_ghost_api_key
GHOST_URL=https://your-ghost-blog.com

# ============================================
# ANALYTICS CREDENTIALS
# ============================================
# Google Analytics
GOOGLE_ANALYTICS_TRACKING_ID=GA-XXXXXXXXX-X
GOOGLE_ANALYTICS_CREDENTIALS_FILE=path/to/credentials.json

# Google Search Console
GOOGLE_SEARCH_CONSOLE_CREDENTIALS_FILE=path/to/credentials.json
GOOGLE_SEARCH_CONSOLE_SITE_URL=https://yourstartup.com

# ============================================
# APPLICATION SETTINGS
# ============================================
# Deployment Settings
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Security
SECRET_KEY=your_super_secret_key_for_jwt_tokens_change_this_to_random_string

# Database
DATABASE_URL=sqlite:///./data/content.db

# Git Repository (for content versioning)
GIT_REPOSITORY_URL=https://github.com/yourusername/founder-socials-content

# ============================================
# STARTUP INFORMATION
# ============================================
STARTUP_NAME=Your Startup Name
STARTUP_DESCRIPTION=Brief description of your startup and what you do
STARTUP_INDUSTRY=Technology
STARTUP_WEBSITE=https://yourstartup.com
STARTUP_BLOG_URL=https://yourstartup.com/blog
STARTUP_TARGET_AUDIENCE=Startup founders, tech professionals, entrepreneurs
STARTUP_BRAND_VOICE=Professional yet approachable, innovative, helpful, authentic
